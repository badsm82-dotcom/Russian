# Copier en .env et adapter. Aucun secret réel dans le dépôt.
DATABASE_URL=postgres://r365:r365@localhost:5432/r365
# Base dédiée aux tests d'intégration (réinitialisée à chaque fichier de test).
TEST_DATABASE_URL=postgres://r365:r365@localhost:5432/r365_test
PORT=3000
HOST=127.0.0.1
TOKEN_TTL_DAYS=30
# true : sert aussi le contenu « pending_review » (développement / pilote personnel).
# false : seuls les contenus validés par un russophone sont servis (production).
ALLOW_PENDING_CONTENT=true
# Dossier du build web à servir par le serveur (optionnel ; en dev, utiliser Vite).
WEB_DIST=apps/web/dist
LOG_LEVEL=info
# Hébergement dans un sous-dossier (ex. /russian) ; vide = racine du domaine.
BASE_PATH=
# false : plus personne ne peut créer de compte (usage personnel).
REGISTRATION_OPEN=true
# Compte de démonstration créé par `npm run db:seed` (optionnel).
DEMO_EMAIL=demo@russian365.local
DEMO_PASSWORD=
